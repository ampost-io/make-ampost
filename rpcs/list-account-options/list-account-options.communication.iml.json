{
	"url": "/api/accounts",
	"method": "GET",
	"qs": {
		"limit": 100
	},
	"response": {
		"limit": 300,
		"iterate": "{{body.data}}",
		"output": {
			"label": "{{ifempty(item.username, item.platformAccountId)}} ({{item.platform}})",
			"value": "{{item.id}}"
		}
	},
	"pagination": {
		"qs": {
			"offset": "{{(pagination.page - 1) * 100}}"
		},
		"condition": "{{body.pagination.hasMore}}"
	}
}
