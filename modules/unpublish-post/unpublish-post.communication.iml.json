{
	"url": "/api/posts/{{encodeURL(parameters.postId)}}/unpublish",
	"method": "POST",
	"body": {
		"{{...}}": "{{omit(parameters, 'postId')}}"
	},
	"response": {
		"output": {
			"{{...}}": "{{omit(body, 'scheduledFor', 'createdAt', 'updatedAt')}}",
			"scheduledFor": "{{if(body.scheduledFor, parseDate(body.scheduledFor), body.scheduledFor)}}",
			"createdAt": "{{if(body.createdAt, parseDate(body.createdAt), body.createdAt)}}",
			"updatedAt": "{{if(body.updatedAt, parseDate(body.updatedAt), body.updatedAt)}}"
		}
	}
}
