{
	"url": "/api/analytics/followers",
	"method": "GET",
	"qs": {
		"{{...}}": "{{omit(parameters, 'limit')}}",
		"limit": 100
	},
	"response": {
		"limit": "{{ifempty(parameters.limit, 10)}}",
		"iterate": "{{body.data}}",
		"output": {
			"{{...}}": "{{omit(item, 'syncedAt')}}",
			"syncedAt": "{{if(item.syncedAt, parseDate(item.syncedAt), item.syncedAt)}}"
		}
	},
	"pagination": {
		"qs": {
			"offset": "{{(pagination.page - 1) * 100}}"
		},
		"condition": "{{body.pagination.hasMore}}"
	}
}
