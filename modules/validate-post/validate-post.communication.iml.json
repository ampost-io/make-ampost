{
	"url": "/api/posts/validate",
	"method": "POST",
	"body": {
		"{{...}}": "{{omit(parameters, 'when', 'scheduledFor', 'options', 'youtube', 'tiktok', 'pinterest', 'instagram', 'facebook', 'linkedin', 'metadata', 'Idempotency-Key')}}",
		"options": {
			"{{...}}": "{{parseJSON(ifempty(parameters.options, '{}'))}}",
			"youtube": "{{ifempty(parameters.youtube, get(parseJSON(ifempty(parameters.options, '{}')), 'youtube'))}}",
			"tiktok": "{{ifempty(parameters.tiktok, get(parseJSON(ifempty(parameters.options, '{}')), 'tiktok'))}}",
			"pinterest": "{{ifempty(parameters.pinterest, get(parseJSON(ifempty(parameters.options, '{}')), 'pinterest'))}}",
			"instagram": "{{ifempty(parameters.instagram, get(parseJSON(ifempty(parameters.options, '{}')), 'instagram'))}}",
			"facebook": "{{ifempty(parameters.facebook, get(parseJSON(ifempty(parameters.options, '{}')), 'facebook'))}}",
			"linkedin": "{{ifempty(parameters.linkedin, get(parseJSON(ifempty(parameters.options, '{}')), 'linkedin'))}}"
		},
		"metadata": "{{if(parameters.metadata, toCollection(ifempty(parameters.metadata, emptyarray), 'key', 'value'), undefined)}}",
		"scheduledFor": "{{if(parameters.when == 'schedule', parameters.scheduledFor, undefined)}}",
		"publishNow": "{{if(parameters.when == 'now', true, undefined)}}",
		"useQueue": "{{if(parameters.when == 'queue', true, undefined)}}"
	},
	"response": {
		"output": {
			"{{...}}": "{{omit(body, 'scheduledFor')}}",
			"scheduledFor": "{{if(body.scheduledFor, parseDate(body.scheduledFor), body.scheduledFor)}}"
		}
	}
}
