{
	"url": "/api/accounts",
	"method": "GET",
	"qs": {
		"{{...}}": "{{omit(parameters, 'limit')}}",
		"limit": 100
	},
	"response": {
		"limit": "{{ifempty(parameters.limit, 10)}}",
		"iterate": "{{body.data}}",
		"output": {
			"{{...}}": "{{omit(item, 'tokenExpiresAt', 'createdAt', 'updatedAt', 'lastUsedAt')}}",
			"tokenExpiresAt": "{{if(item.tokenExpiresAt, parseDate(item.tokenExpiresAt), item.tokenExpiresAt)}}",
			"createdAt": "{{if(item.createdAt, parseDate(item.createdAt), item.createdAt)}}",
			"updatedAt": "{{if(item.updatedAt, parseDate(item.updatedAt), item.updatedAt)}}",
			"lastUsedAt": "{{if(item.lastUsedAt, parseDate(item.lastUsedAt), item.lastUsedAt)}}"
		}
	},
	"pagination": {
		"qs": {
			"offset": "{{(pagination.page - 1) * 100}}"
		},
		"condition": "{{body.pagination.hasMore}}"
	}
}
