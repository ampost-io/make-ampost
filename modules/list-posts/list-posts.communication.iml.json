{
	"url": "/api/posts",
	"method": "GET",
	"qs": {
		"{{...}}": "{{omit(parameters, 'limit')}}",
		"limit": 100
	},
	"response": {
		"limit": "{{ifempty(parameters.limit, 10)}}",
		"iterate": "{{body.data}}",
		"output": {
			"{{...}}": "{{omit(item, 'scheduledFor', 'createdAt', 'updatedAt')}}",
			"scheduledFor": "{{if(item.scheduledFor, parseDate(item.scheduledFor), item.scheduledFor)}}",
			"createdAt": "{{if(item.createdAt, parseDate(item.createdAt), item.createdAt)}}",
			"updatedAt": "{{if(item.updatedAt, parseDate(item.updatedAt), item.updatedAt)}}"
		}
	},
	"pagination": {
		"qs": {
			"offset": "{{(pagination.page - 1) * 100}}"
		},
		"condition": "{{body.pagination.hasMore}}"
	}
}
