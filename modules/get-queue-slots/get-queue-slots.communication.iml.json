{
	"url": "/api/platform-sets/{{encodeURL(parameters.platformSetId)}}/queue/slots",
	"method": "GET",
	"qs": {
		"{{...}}": "{{omit(parameters, 'platformSetId')}}"
	},
	"response": {
		"limit": "{{ifempty(parameters.count, 10)}}",
		"iterate": "{{body.slots}}",
		"output": {
			"{{...}}": "{{omit(item, 'scheduledFor')}}",
			"scheduledFor": "{{if(item.scheduledFor, parseDate(item.scheduledFor), item.scheduledFor)}}",
			"free": "{{!item.postId}}",
			"platformSetId": "{{body.platformSetId}}",
			"timezone": "{{body.timezone}}"
		}
	}
}
