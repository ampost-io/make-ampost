{
  "name": "Schedule posts from Google Sheets (Ampost app)",
  "flow": [
    {
      "id": 1,
      "module": "google-sheets:watchRows",
      "version": 2,
      "parameters": {
        "__IMTCONN__": null,
        "mode": "select",
        "spreadsheetId": "YOUR_SPREADSHEET_ID",
        "sheetId": "Posts",
        "includesHeaders": true,
        "tableFirstRow": "A1:Z1",
        "limit": 10
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        }
      }
    },
    {
      "id": 2,
      "module": "ampost:createPost",
      "version": 1,
      "parameters": {
        "__IMTCONN__": null
      },
      "mapper": {
        "targets": [
          {
            "platforms": [
              "linkedin",
              "facebook",
              "threads",
              "twitter",
              "bluesky",
              "telegram",
              "discord"
            ]
          }
        ],
        "text": "{{1.`0`}}",
        "linkUrl": "{{ifempty(1.`2`; null)}}",
        "when": "schedule",
        "scheduledFor": "{{1.`1`}}",
        "Idempotency-Key": "sheet-{{1.`__ROW_NUMBER__`}}-{{md5(1.`0`)}}"
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        }
      }
    },
    {
      "id": 3,
      "module": "google-sheets:updateRow",
      "version": 2,
      "parameters": {
        "__IMTCONN__": null
      },
      "mapper": {
        "mode": "select",
        "spreadsheetId": "YOUR_SPREADSHEET_ID",
        "sheetId": "Posts",
        "includesHeaders": true,
        "rowNumber": "{{1.`__ROW_NUMBER__`}}",
        "values": {
          "3": "{{2.id}}",
          "4": "{{2.status}}"
        }
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0
        }
      }
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "designer": {
      "orphans": []
    },
    "scenario": {
      "dlq": false,
      "slots": null,
      "dataloss": false,
      "maxErrors": 3,
      "autoCommit": true,
      "roundtrips": 1,
      "sequential": false,
      "confidential": false,
      "freshVariables": false,
      "autoCommitTriggerLast": true
    }
  }
}
