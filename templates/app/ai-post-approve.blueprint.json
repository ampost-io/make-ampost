{
  "name": "AI-written post with approval (2 of 2: publish on approval) (Ampost app)",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": null,
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        }
      }
    },
    {
      "id": 2,
      "module": "ampost:publishPost",
      "version": 1,
      "parameters": {
        "__IMTCONN__": null
      },
      "mapper": {
        "postId": "{{1.postId}}",
        "Idempotency-Key": "approve-{{1.postId}}"
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        }
      },
      "filter": {
        "name": "Approval token matches and the post ID is a UUID",
        "conditions": [
          [
            {
              "a": "{{1.token}}",
              "b": "YOUR_APPROVAL_TOKEN",
              "o": "text:equal"
            },
            {
              "a": "{{1.postId}}",
              "b": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
              "o": "text:pattern"
            }
          ]
        ]
      }
    },
    {
      "id": 3,
      "module": "gateway:WebhookRespond",
      "version": 1,
      "parameters": {},
      "mapper": {
        "body": "{\"postId\": \"{{2.id}}\", \"status\": \"{{2.status}}\"}",
        "status": "200",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0
        }
      }
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "designer": {
      "orphans": []
    },
    "scenario": {
      "dlq": false,
      "slots": null,
      "dataloss": false,
      "maxErrors": 3,
      "autoCommit": true,
      "roundtrips": 1,
      "sequential": false,
      "confidential": false,
      "freshVariables": false,
      "autoCommitTriggerLast": true
    }
  }
}
